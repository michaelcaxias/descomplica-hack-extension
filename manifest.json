{
    "manifest_version": 3,
    "name": "Descomplica Hack",
    "version": "2.2.0",
    "description": "Destaca e seleciona as respostas nos exercícios da Descomplica, com opção de otimizar o carregamento das páginas.",
    "permissions": [
        "storage",
        "scripting",
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "*://aulas.descomplica.com.br/*",
        "*://*.descomplica.com.br/*",
        "https://cdnapisec.kaltura.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "opt_kaltura",
                "enabled": false,
                "path": "optimizer/rules_kaltura.json"
            },
            {
                "id": "opt_block3p",
                "enabled": false,
                "path": "optimizer/rules_block3p.json"
            },
            {
                "id": "opt_cache",
                "enabled": false,
                "path": "optimizer/rules_cache.json"
            }
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "https://aulas.descomplica.com.br/graduacao/*"
            ],
            "js": [
                "optimizer/content_main.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://aulas.descomplica.com.br/graduacao/*"
            ],
            "js": [
                "optimizer/content_iso.js"
            ],
            "run_at": "document_start"
        }
    ]
}